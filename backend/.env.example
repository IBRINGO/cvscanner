# Backend-local override of the root .env.example. When running the backend
# outside Docker (e.g. `python manage.py runserver` from a virtualenv),
# copy this to `backend/.env` and adjust POSTGRES_HOST/REDIS_URL to point at
# services reachable from your host (Docker Compose sets these already).

POSTGRES_DB=cvscanner
POSTGRES_USER=cvscanner
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://cvscanner:change-me@localhost:5432/cvscanner

REDIS_URL=redis://localhost:6379/0

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

CORS_ALLOWED_ORIGINS=http://localhost:4200
