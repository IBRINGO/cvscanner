# Copy this file to `.env` and adjust values for your local environment.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=cvscanner
POSTGRES_USER=cvscanner
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection string used by Django (must stay consistent with the values above)
DATABASE_URL=postgres://cvscanner:change-me@postgres:5432/cvscanner

# ---------------------------------------------------------------------------
# Redis (Celery broker/result backend + caching)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Future integrations (documented for later phases, not used yet)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=
