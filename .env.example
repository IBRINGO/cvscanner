# Copy this file to `.env` and adjust values for your local environment.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=cvscanner
POSTGRES_USER=cvscanner
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection string used by Django (must stay consistent with the values above)
DATABASE_URL=postgres://cvscanner:change-me@postgres:5432/cvscanner

# ---------------------------------------------------------------------------
# Redis (Celery broker/result backend + caching)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Embeddings (Phase 3, extended Phase 4) - optional. Unset uses the
# deterministic FakeEmbeddingProvider (no network, no key needed).
# GEMINI_API_KEY is the primary provider; OPENAI_API_KEY is the fallback
# if Gemini is unset or a call fails. Either, both, or neither may be set.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LLM text generation (Phase 5) - optional, reuses the same GEMINI_API_KEY/
# OPENAI_API_KEY above. Only used for AGGRESSIVE_SAFE tailoring's bullet
# rewriting; unset falls back to the deterministic FakeLLMProvider.
# ---------------------------------------------------------------------------
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Future integrations (documented for later phases, not used yet)
# ---------------------------------------------------------------------------
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=
